# Environment Configuration
PROJECT_NAME="Predictive Maintenance MLOps System"
ENVIRONMENT="development"

# Paths
DATA_DIR="data"
RAW_DATA_PATH="data/raw/ai4i2020.csv"
PROCESSED_DATA_PATH="data/processed/ai4i2020_processed.csv"
QUALITY_REPORT_PATH="data/reports/data_quality_report.json"
DATABASE_PATH="data/database/predictive_maintenance.db"

# Data Ingestion Source URL
DATASET_URL="https://archive.ics.uci.edu/ml/machine-learning-databases/00601/ai4i2020.csv"

# MLflow Tracking & Registry Configuration
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_EXPERIMENT_NAME="predictive-maintenance"
MLFLOW_REGISTERED_MODEL_NAME="PredictiveMaintenanceModel"

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"
